{
  "name": "velotech-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node init && node scripts/scan-ai-images.mjs && vite",
    "build": "node init && node scripts/scan-ai-images.mjs && vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "placeholders": "node scripts/generate-placeholders.mjs",
    "build:spa": "node init && vite build",
    "og": "vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/generate-og.mjs",
    "images": "node scripts/scan-ai-images.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "gsap": "^3.13.0",
    "lenis": "^1.3.4",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "puppeteer-core": "^23.11.1",
    "vite": "^8.3.8"
  }
}
